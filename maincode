    {
      "parameters": {
        "functionCode": "// Generate social media hooks based on analysis\nconst data = items[0].json;\n\n// Simple hook generator (no AI needed)\nconst generateHooks = (article) => {\n  const title = article.title || 'Amazing Discovery';\n  const firstParagraph = article.firstParagraph || '';\n  \n  // Extract key elements\n  const hasNumbers = title.match(/\\d+/);\n  const number = hasNumbers ? hasNumbers[0] : '10';\n  \n  // Generate platform-specific hooks\n  const hooks = {\n    instagram: {\n      primary: `🌍 ${title}`,\n      carousel_opener: `Swipe to discover something incredible about ${title.split(' ')[0]}...`,\n      cta: 'Link in bio for full story'\n    },\n    \n    tiktok: {\n      opener: `You won't believe what scientists just discovered`,\n      hook: title.length > 50 ? title.substring(0, 50) + '...' : title,\n      format: 'POV: You just learned something that will blow your mind'\n    },\n    \n    twitter: {\n      thread_starter: `🧵 ${title}\\n\\nA thread on why this matters:`,\n      single_tweet: title.length > 200 ? title.substring(0, 200) + '...' : title,\n      quote_tweet: `This changes everything we thought we knew`\n    },\n    \n    linkedin: {\n      professional: `Key Insights: ${title}`,\n      thought_leadership: `What we can learn from ${title.split(' ').slice(0, 5).join(' ')}...`,\n      discussion_starter: `Curious about your thoughts on this discovery`\n    },\n    \n    youtube: {\n      shorts_title: title.length > 60 ? title.substring(0, 57) + '...' : title,\n      thumbnail_text: hasNumbers ? `${number} SHOCKING FACTS` : 'MUST SEE',\n      description_hook: `In this video, we explore ${title.toLowerCase()}`\n    }\n  };\n  \n  // Content snippets for each platform\n  const snippets = {\n    short: firstParagraph.substring(0, 100) + '...',\n    medium: firstParagraph.substring(0, 200) + '...',\n    long: firstParagraph\n  };\n  \n  return {\n    hooks,\n    snippets,\n    hashtags: {\n      general: '#NationalGeographic #Discovery #Science #Education',\n      instagram: '#NatGeo #InstaScience #DidYouKnow #ExploreMore',\n      tiktok: '#FYP #LearnOnTikTok #ScienceFacts #MindBlown',\n      twitter: '#Science #Breaking #Research #Nature'\n    }\n  };\n};\n\nconst socialContent = generateHooks(data);\n\nreturn [{\n  json: {\n    ...data,\n    generatedContent: socialContent,\n    totalHooks: 15\n  }\n}];"
      },
