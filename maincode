    {
      "parameters": {
        "functionCode": "// Analyze content for social media potential\nconst article = items[0].json;\n\n// Simple shareability analysis\nconst analyzeShareability = (article) => {\n  const scores = {\n    emotional: 0,\n    curiosity: 0,\n    visual: 0,\n    readability: 0,\n    overall: 0\n  };\n  \n  const insights = [];\n  const title = article.title || '';\n  const text = article.textSnippet || '';\n  \n  // Emotional triggers (words that drive engagement)\n  const emotionalWords = ['amazing', 'incredible', 'shocking', 'unbelievable', 'extraordinary', 'dangerous', 'mysterious', 'discover', 'reveal', 'secret'];\n  const emotionalCount = emotionalWords.filter(word => \n    text.toLowerCase().includes(word) || title.toLowerCase().includes(word)\n  ).length;\n  scores.emotional = Math.min(emotionalCount * 20, 100);\n  if (scores.emotional > 40) insights.push('Contains emotional triggers');\n  \n  // Curiosity gaps\n  const curiosityPatterns = ['how', 'why', 'what', 'when', 'where', '?'];\n  const curiosityCount = curiosityPatterns.filter(pattern => \n    title.toLowerCase().includes(pattern)\n  ).length;\n  scores.curiosity = Math.min(curiosityCount * 25, 100);\n  if (scores.curiosity > 0) insights.push('Title creates curiosity gap');\n  \n  // Visual content\n  scores.visual = Math.min(article.imageCount * 10, 100);\n  if (scores.visual > 50) insights.push('Rich visual content');\n  \n  // Readability (simple = better for social)\n  const avgWordLength = text.split(' ').reduce((acc, word) => acc + word.length, 0) / text.split(' ').length;\n  scores.readability = avgWordLength < 6 ? 80 : avgWordLength < 8 ? 60 : 40;\n  if (scores.readability > 60) insights.push('Easy to read');\n  \n  // Calculate overall score\n  scores.overall = Math.round(\n    (scores.emotional + scores.curiosity + scores.visual + scores.readability) / 4\n  );\n  \n  // Platform recommendations\n  const recommendations = [];\n  if (scores.visual > 70) recommendations.push('Instagram - High visual appeal');\n  if (scores.curiosity > 60) recommendations.push('TikTok - Strong hook potential');\n  if (scores.emotional > 50) recommendations.push('Twitter - Emotional resonance');\n  if (scores.readability > 70) recommendations.push('LinkedIn - Professional clarity');\n  \n  return {\n    scores,\n    insights,\n    recommendations,\n    shareabilityRating: scores.overall > 70 ? 'High' : scores.overall > 50 ? 'Medium' : 'Low'\n  };\n};\n\nconst analysis = analyzeShareability(article);\n\nreturn [{\n  json: {\n    ...article,\n    shareability: analysis\n  }\n}];"
      },
      "id": "500e4cc1-e7df-47f2-bc80-b5ad7f048d98",
      "name": "Analyze Shareability",
