    {
      "parameters": {
        "functionCode": "// Extract article content from HTML\nconst html = items[0].json.data || items[0].json;\nconst url = items[0].json.url;\n\n// Basic content extraction\nconst extractContent = (html) => {\n  // Extract title\n  const titleMatch = html.match(/<title>([^<]+)<\\/title>/i);\n  const title = titleMatch ? titleMatch[1].replace(' | National Geographic Kids', '').trim() : 'Unknown Title';\n  \n  // Extract main text (remove HTML tags)\n  const textContent = html\n    .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n  \n  // Extract first paragraph for summary\n  const paragraphMatch = html.match(/<p[^>]*>([^<]+)<\\/p>/i);\n  const firstParagraph = paragraphMatch ? paragraphMatch[1].trim() : '';\n  \n  // Count images\n  const imageMatches = html.match(/<img[^>]+>/gi) || [];\n  const imageCount = imageMatches.length;\n  \n  // Extract meta description\n  const metaMatch = html.match(/<meta[^>]*name=\"description\"[^>]*content=\"([^\"]+)\"/i);\n  const metaDescription = metaMatch ? metaMatch[1] : '';\n  \n  return {\n    title,\n    firstParagraph,\n    metaDescription,\n    wordCount: textContent.split(' ').length,\n    imageCount,\n    textSnippet: textContent.substring(0, 500)\n  };\n};\n\nconst content = extractContent(html.toString());\n\nreturn [{\n  json: {\n    url: url,\n    ...content,\n    extractedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "785421fd-5f5c-4031-a7b6-cd34c998034b",
      "name": "Extract Article Content",
