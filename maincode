    {
      "parameters": {
        "functionCode": "// Compile final analysis and structure data\nconst data = (items[0] && items[0].json) ? items[0].json : {};\n \nconst finalAnalysis = {\n  metadata: {\n    analysisId: Date.now().toString(),\n    timestamp: new Date().toISOString(),\n    url: data.url ?? null,\n  },\n  articleInfo: {\n    title: data.title ?? \"Unknown Title\",\n    wordCount: data.wordCount ?? 0,\n    imageCount: data.imageCount ?? 0,\n    firstParagraph: data.firstParagraph ?? \"\",\n    metaDescription: data.metaDescription ?? \"\",\n  },\n  shareabilityAnalysis: data.shareability ?? {\n    scores: { visual: 0, emotional: 0, curiosity: 0 },\n    shareabilityRating: \"Unknown\",\n    recommendations: [],\n  },\n  generatedContent: {\n    hooks: (data.generatedContent && data.generatedContent.hooks) || [],\n    snippets: (data.generatedContent && data.generatedContent.snippets) || [],\n    hashtags: (data.generatedContent && data.generatedContent.hashtags) || [],\n  },\n  trendAnalysis: data.trendAnalysis ?? {},\n  recommendations: {\n    topPlatforms: (data.shareability && data.shareability.recommendations) || [],\n    contentStrategy: [\n      (data.shareability?.scores?.visual ?? 0) > 70 ? \"Focus on visual content\" : \"Add more images\",\n      (data.shareability?.scores?.emotional ?? 0) > 50 ? \"Leverage emotional angle\" : \"Add emotional hooks\",\n      (data.shareability?.scores?.curiosity ?? 0) > 60 ? \"Use curiosity-driven titles\" : \"Create knowledge gaps\",\n      \"Post during peak hours (12-2 PM, 7-9 PM)\",\n    ],\n    estimatedEngagement: {\n      low: 1000,\n      medium: 5000,\n      high: 10000,\n      predicted:\n        (data.shareability?.shareabilityRating === \"High\") ? 8000 :\n        (data.shareability?.shareabilityRating === \"Medium\") ? 4000 : 2000,\n    },\n  },\n  actionItems: [\n    \"Create Instagram carousel with 5 slides\",\n    \"Film 30-second TikTok with strong hook\",\n    \"Write Twitter thread (5 tweets)\",\n    \"Draft LinkedIn post with professional angle\",\n    \"Create YouTube Shorts script\",\n  ],\n};\n \n// --- make a binary JSON file so \"Save to JSON File\" can consume it ---\nconst fileName = `natgeo_analysis_${finalAnalysis.metadata.analysisId}.json`;\nconst buf = Buffer.from(JSON.stringify(finalAnalysis, null, 2));\n \nreturn [{\n  json: finalAnalysis,\n  binary: {\n    file: {\n      data: buf.toString('base64'),\n      fileName,\n      mimeType: 'application/json',\n    }\n  }\n}];"
      },
