        "functionCode": "// Display summary of analysis\nconst data = items[0].json;\n\nconst summary = {\n  '📊 Analysis Complete': {\n    'Article': data.articleInfo.title,\n    'Shareability Score': data.shareabilityAnalysis.scores.overall + '/100',\n    'Rating': data.shareabilityAnalysis.shareabilityRating,\n    'Best Platforms': data.recommendations.topPlatforms,\n    'Estimated Reach': data.recommendations.estimatedEngagement.predicted + ' users',\n    'Hooks Generated': 15,\n    'File Saved': `natgeo_analysis_${data.metadata.analysisId}.json`\n  },\n  \n  '🎯 Top Insights': data.shareabilityAnalysis.insights,\n  \n  '📱 Platform Hooks': {\n    'Instagram': data.generatedContent.hooks.instagram.primary,\n    'TikTok': data.generatedContent.hooks.tiktok.opener,\n    'Twitter': data.generatedContent.hooks.twitter.single_tweet\n  },\n  \n  '✅ Next Steps': data.actionItems\n};\n\nreturn [{\n  json: summary\n}];"
